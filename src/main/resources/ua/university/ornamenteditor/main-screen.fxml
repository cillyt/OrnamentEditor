<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import javafx.collections.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="ua.university.ornamenteditor.MainScreenController">
    <StackPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <ImageView fitHeight="700.0" fitWidth="900.0" pickOnBounds="true" preserveRatio="true">
         <image>
             <Image url="@ornament.jpg" />
         </image>
      </ImageView>
      <VBox prefHeight="600.0" prefWidth="900.0">
        <children>
          <MenuBar VBox.vgrow="NEVER">
            <menus>
              <Menu mnemonicParsing="false" text="Новий візерунок">
                <items>
                  <MenuItem mnemonicParsing="false" text="Створити новий візерунок" />
                        <MenuItem mnemonicParsing="false" text="Згенерувати візерунок" />
                </items>
              </Menu>
              <Menu mnemonicParsing="false" text="Зберегти">
                <items>
                  <MenuItem mnemonicParsing="false" text="Зберегти як..." />
                </items>
              </Menu>
              <Menu mnemonicParsing="false" text="Відкрити">
                <items>
                  <MenuItem mnemonicParsing="false" text="Відкрити візерунок" />
                </items>
              </Menu>
                  <Menu mnemonicParsing="false" text="Інструкція">
                     <items>
                        <MenuItem mnemonicParsing="false" text="Відкрити інструкцію щодо використання" />
                     </items>
                  </Menu>
            </menus>
          </MenuBar>
          <AnchorPane maxHeight="-1.0" maxWidth="-1.0" prefHeight="596.0" prefWidth="902.0" VBox.vgrow="ALWAYS">
            <children>
                  <Button layoutX="428.0" layoutY="489.0" mnemonicParsing="false" onAction="#printOrnament" prefHeight="70.0" prefWidth="277.0" text="Вишити!" textAlignment="CENTER">
                     <font>
                        <Font name="Palatino Linotype Italic" size="21.0" />
                     </font>
                  </Button>
                  <ImageView fitHeight="470.0" fitWidth="470.0" layoutX="333.0" layoutY="18.0" onMouseClicked="#printCross" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@grid.png" />
                     </image>
                  </ImageView>
                <Canvas fx:id="myCanvas" width="470.0" height="470.0" layoutX="333.0" layoutY="18.0" onMouseClicked="#printCross" />
                <ImageView fitHeight="528.0" fitWidth="278.0" layoutX="36.0" layoutY="26.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                         <Image url="@back2.jpg" />
                     </image>
                  </ImageView>
                  <ColorPicker fx:id="pickedColor" layoutX="86.0" layoutY="281.0" prefHeight="46.0" prefWidth="178.0" promptText="Обрати колір..." />
                  <RadioButton fx:id="clearOne" layoutX="86.0" layoutY="367.0" mnemonicParsing="false" onAction="#cleanOneCross" prefHeight="46.0" prefWidth="178.0" text="Очистити клітинку">
                     <font>
                        <Font name="Palatino Linotype Italic" size="15.0" />
                     </font>
                  </RadioButton>
                <ChoiceBox fx:id="chooseSymetry" layoutX="86.0" layoutY="113.0" onAction="#chooseSymetry" prefHeight="46.0" prefWidth="178.0">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Немає" />
                            <String fx:value="Вертикальна" />
                            <String fx:value="Горизонтальна" />
                        </FXCollections>
                    </items>
                    <value>
                        <String fx:value="Немає" />
                    </value>
                </ChoiceBox>
                  <Button layoutX="86.0" layoutY="432.0" mnemonicParsing="false" onAction="#cleanCanvas" prefHeight="46.0" prefWidth="178.0" text="Очистити полотно">
                     <font>
                        <Font name="Palatino Linotype Italic" size="17.0" />
                     </font>
                  </Button>


                <ChoiceBox fx:id="chooseDuplication" layoutX="86.0" layoutY="185.0" prefHeight="46.0" prefWidth="178.0">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Немає" />
                            <String fx:value="Вертикальне" />
                            <String fx:value="Горизонтальне" />
                        </FXCollections>
                    </items>
                    <value>
                        <String fx:value="Немає" />
                    </value>
                </ChoiceBox>


                  <Separator layoutX="36.0" layoutY="246.0" prefHeight="26.0" prefWidth="278.0" />
                  <Separator layoutX="36.0" layoutY="341.0" prefHeight="26.0" prefWidth="278.0" />
                  <Text layoutX="86.0" layoutY="69.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Налаштування" wrappingWidth="178.39999999999998">
                     <font>
                        <Font name="Palatino Linotype Bold Italic" size="23.0" />
                     </font>
                  </Text>
                  <Separator layoutX="36.0" layoutY="76.0" prefHeight="26.0" prefWidth="278.0" />
            </children>
          </AnchorPane>
        </children>
      </VBox>
   </children>
</StackPane>
</VBox>
